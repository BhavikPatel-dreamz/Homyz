// Prisma schema for homyz — auth, roles, and domain models.
// Prisma 7 "prisma-client" generator: the datasource connection URL is supplied
// by prisma7.config.ts (which loads .env via dotenv). See lib/db/prisma.ts for
// the runtime client (it passes datasourceUrl explicitly).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  HOST
  USER
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  PHONE_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITATION_PENDING
}

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  FAILED
}

enum HostRegistrationStatus {
  PENDING
  IN_REVIEW
  WAITING_FOR_DOCUMENTS
  DOCUMENTS_UNDER_REVIEW
  APPROVED
  REJECTED
}

enum HostDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum HostComplianceStatus {
  PENDING
  UNDER_REVIEW
  ACTION_REQUIRED
  COMPLIANT
  NON_COMPLIANT
}

enum ComplianceCheckStatus {
  PENDING
  PASSED
  FAILED
}

enum ComplianceIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceIssueStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  ACTIVE
}

enum HostingType {
  HOME
  EXPERIENCE
  SERVICE
}



// ─────────────────────────────────────────────────────────────────────────────
// Auth / identity (NextAuth adapter models: User, Account, Session,
// VerificationToken — shapes required by @next-auth/prisma-adapter)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  publicProfile Json?       // Stores bio, prompts, stamps visibility, etc.
  // Local credentials + custom fields
  passwordHash  String?
  role          Role        @default(USER)
  status        UserStatus  @default(ACTIVE)
  lastLoginAt   DateTime?
  adminRoleId   String?
  phone         String?     @unique
  phoneVerified DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tokenVersion  Int         @default(0)

  accounts            Account[]
  sessions            Session[]
  listings            Listing[]
  bookings            Booking[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  adminRole           AdminRole?              @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  auditLogs           AuditLog[]
  hostPermissionOverrides HostPermissionOverride[] @relation("HostOverrides")
  createdHostOverrides    HostPermissionOverride[] @relation("HostOverridesCreated")
  adminPermissionOverrides AdminPermissionOverride[] @relation("AdminOverrides")
  createdAdminOverrides    AdminPermissionOverride[] @relation("AdminOverridesCreated")
  sentInvitations          AdminInvitation[]        @relation("InvitedByAdmins")
  assignedHostRegistrations HostRegistrationRequest[] @relation("AssignedRegistrations")
  reviewedHostRegistrations HostRegistrationRequest[] @relation("ReviewedRegistrations")
  hostRegistrations        HostRegistrationRequest[] @relation("HostRegistrations")
  verifiedHostDocuments    HostRegistrationDocument[] @relation("VerifiedDocuments")
  rejectedHostDocuments    HostRegistrationDocument[] @relation("RejectedDocuments")
  createdRegistrationNotes HostRegistrationNote[]     @relation("CreatedRegistrationNotes")
  complianceReviewedRegistrations HostRegistrationRequest[] @relation("ComplianceReviewedRegistrations")
  approvedRegistrations HostRegistrationRequest[] @relation("ApprovedRegistrations")
  reopenedRegistrations HostRegistrationRequest[] @relation("ReopenedRegistrations")
  completedComplianceChecks HostComplianceCheck[] @relation("CompletedComplianceChecks")
  createdComplianceIssues HostComplianceIssue[] @relation("CreatedComplianceIssues")
  resolvedComplianceIssues HostComplianceIssue[] @relation("ResolvedComplianceIssues")
  createdInfoRequests HostInfoRequest[] @relation("CreatedInfoRequests")
  tripPhotos         TripPhoto[]

  @@index([role])
  @@index([adminRoleId])
  @@index([status])
}

model TripPhoto {
  id        String   @id @default(cuid())
  userId    String
  url       String
  caption   String?
  location  String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?
  lastActiveAt DateTime @default(now())
  isRevoked    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Custom auth flows: OTP, password reset, mobile refresh tokens
// ─────────────────────────────────────────────────────────────────────────────

model OtpCode {
  id         String     @id @default(cuid())
  identifier String // phone number (SMS) or email
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([identifier, purpose])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Long-lived mobile refresh tokens. Stored hashed; rotated on refresh, revoked on logout.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain models — exercise host ownership (Listing) and user ownership (Booking)
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id                  String        @id @default(cuid())
  hostId              String
  title               String
  description         String        @db.Text
  price               Int           // minor units (e.g. cents) per night
  published           Boolean       @default(false)
  status              ListingStatus @default(DRAFT)
  hostingType         HostingType   @default(HOME)

  // Step 1 — Property & Location Details
  propertyType        String?       // House, Apartment, Villa, Cabin, Cottage, etc.
  listingType         String?       // Entire place, Private room, Shared room
  address             String?       @db.Text
  city                String?
  district            String?
  postalCode          String?
  country             String?
  latitude            Float?
  longitude           Float?
  showExactLocation   Boolean       @default(true)

  guests              Int           @default(1)
  bedrooms            Int           @default(1)
  beds                Int           @default(1)
  bathrooms           Int           @default(1)

  // Step 2 — Photos & Content Details
  photos              String[]      @default([]) // Min 5 photos required for submission
  highlights          String[]      @default([]) // Max 3 highlights
  amenities           String[]      @default([]) // Amenities list (WiFi, Pool, Kitchen, Parking, Aircon, etc.)
  safetyDisclosures   String[]      @default([])

  // Step 3 — House Rules & Check-in Details
  houseRules          String[]      @default([]) // No smoking, Pets allowed, Quiet hours, etc.
  checkInMethod       String?       @default("SMART_LOCK") // SMART_LOCK, KEYPAD, LOCKBOX, HOST_MEET
  checkInStart        String?       @default("15:00")
  checkInEnd          String?       @default("22:00")
  checkOutTime        String?       @default("11:00")

  // Step 4 — Policies & Constraints
  cancellationPolicy  String?       @default("FLEXIBLE") // FLEXIBLE, MODERATE, STRICT, SUPER_STRICT
  minNights           Int           @default(1)
  maxNights           Int           @default(365)
  instantBook         Boolean       @default(true)
  isPaused            Boolean       @default(false)
  isFeatured          Boolean       @default(false)

  // Step 5 — Availability & Dates
  blockedDates        String[]      @default([]) // Array of YYYY-MM-DD blocked dates

  // Pricing & Fees
  cleaningFee         Int?          @default(0) // Fee in cents
  securityDeposit     Int?          @default(0) // Fee in cents
  weekendPrice        Int?          // Weekend price in cents
  weekendPremium      Int?          // Weekend premium percentage
  discounts           Json?         // Discounts configuration

  // Wizard state & progress
  currentStep         Int           @default(1)

  // Admin Review & Approval
  submittedAt         DateTime?
  resubmittedAt       DateTime?
  reviewStartedAt     DateTime?
  reviewerId          String?
  rejectionReason     String?       @db.Text
  requestedChanges    Json?         // Structured action items requested by Admin
  approvedAt          DateTime?
  approvedById        String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([hostId])
  @@index([published])
  @@index([status])
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  listingId String
  status    BookingStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin RBAC & Audit Logging
// ─────────────────────────────────────────────────────────────────────────────

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AdminRolePermission[]
  users       User[]
  invitations AdminInvitation[]


  @@index([slug])
}

model AdminPermission {
  id          String   @id @default(cuid())
  slug        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles AdminRolePermission[]

  @@index([module])
  @@index([slug])
}

model AdminRolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorEmail   String?
  action       String
  resourceType String
  resourceId   String?
  description  String
  status       String   @default("SUCCESS")
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}

model HostPermissionOverride {
  id          String   @id @default(cuid())
  hostId      String
  permission  String
  effect      String   // "ALLOW" or "DENY"
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host      User  @relation("HostOverrides", fields: [hostId], references: [id], onDelete: Cascade)
  createdBy User? @relation("HostOverridesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([hostId, permission])
  @@index([hostId])
}

model AdminPermissionOverride {
  id          String   @id @default(cuid())
  adminId     String
  permission  String
  effect      String   // "ALLOW" or "DENY"
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin     User  @relation("AdminOverrides", fields: [adminId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AdminOverridesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([adminId, permission])
  @@index([adminId])
}

model AdminInvitation {
  id                String                @id @default(cuid())
  email             String
  name              String?
  role              Role                  @default(ADMIN)
  adminRoleId       String?
  tokenHash         String                @unique
  status            AdminInvitationStatus @default(PENDING)
  invitedById       String?
  invitedByEmail    String?
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  lastResentAt      DateTime?
  message           String?               @db.Text
  customPermissions Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  invitedBy User?      @relation("InvitedByAdmins", fields: [invitedById], references: [id], onDelete: SetNull)
  adminRole AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([tokenHash])
}

model HostRegistrationRequest {
  id                  String                 @id @default(cuid())
  applicationId       String                 @unique @default(cuid())
  applicantName       String
  applicantEmail      String
  applicantPhone      String?
  registrationType    String                 @default("INDIVIDUAL")
  businessName        String?
  propertyCount       Int                    @default(1)
  location            String?
  notes               String?                @db.Text
  status              HostRegistrationStatus @default(PENDING)
  onboardingStage     String                 @default("INITIAL_INTAKE")
  
  hostId              String?
  host                User?                  @relation("HostRegistrations", fields: [hostId], references: [id], onDelete: SetNull)
  
  assignedReviewerId  String?
  assignedReviewer    User?                  @relation("AssignedRegistrations", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?

  reviewedById        String?
  reviewedBy          User?                  @relation("ReviewedRegistrations", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewStartedAt     DateTime?

  complianceStatus    HostComplianceStatus   @default(PENDING)
  complianceReviewedById String?
  complianceReviewedBy User?                 @relation("ComplianceReviewedRegistrations", fields: [complianceReviewedById], references: [id], onDelete: SetNull)
  complianceReviewedAt DateTime?
  complianceNotes     String?                @db.Text

  rejectionReason     String?                @db.Text
  approvedById        String?
  approvedBy          User?                  @relation("ApprovedRegistrations", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?

  reopenedById        String?
  reopenedBy          User?                  @relation("ReopenedRegistrations", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenedAt          DateTime?
  reopenReason        String?                @db.Text

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  documents           HostRegistrationDocument[]
  reviewNotes         HostRegistrationNote[]
  complianceChecks    HostComplianceCheck[]
  complianceIssues    HostComplianceIssue[]
  infoRequests        HostInfoRequest[]

  @@index([applicantEmail])
  @@index([applicantPhone])
  @@index([status])
  @@index([complianceStatus])
  @@index([assignedReviewerId])
  @@index([createdAt])
}


model HostRegistrationDocument {
  id                      String             @id @default(cuid())
  requestId               String
  request                 HostRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  documentType            String             // e.g. "GOVERNMENT_ID", "PROOF_OF_ADDRESS", "BUSINESS_LICENSE", "PROPERTY_DEED", "TAX_CERTIFICATE"
  fileName                String
  fileUrl                 String
  mimeType                String?
  fileSize                Int?
  status                  HostDocumentStatus @default(PENDING)
  uploadedAt              DateTime           @default(now())
  expiryDate              DateTime?

  verifiedById            String?
  verifiedBy              User?              @relation("VerifiedDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt              DateTime?

  rejectedById            String?
  rejectedBy              User?              @relation("RejectedDocuments", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt              DateTime?
  rejectionReason         String?

  resubmissionRequested   Boolean            @default(false)
  resubmissionInstructions String?
  resubmissionRequestedAt DateTime?

  version                 Int                @default(1)
  previousDocumentId      String?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([requestId])
  @@index([documentType])
  @@index([status])
}

model HostRegistrationNote {
  id          String                 @id @default(cuid())
  requestId   String
  request     HostRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId    String
  author      User                   @relation("CreatedRegistrationNotes", fields: [authorId], references: [id], onDelete: Cascade)
  authorEmail String
  authorName  String?

  content     String                 @db.Text
  isInternal  Boolean                @default(true)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([requestId])
  @@index([authorId])
  @@index([createdAt])
}

model HostComplianceCheck {
  id          String                @id @default(cuid())
  requestId   String
  request     HostRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  checkKey    String                // e.g. IDENTITY_VERIFIED, ADDRESS_VERIFIED, REQUIRED_DOCUMENTS_VERIFIED, PROPERTY_INFO_COMPLETED, BUSINESS_VERIFICATION, ADDITIONAL_REVIEW
  checkName   String
  status      ComplianceCheckStatus @default(PENDING)

  reviewerId  String?
  reviewer    User?                 @relation("CompletedComplianceChecks", fields: [reviewerId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  notes       String?               @db.Text

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([requestId])
  @@index([checkKey])
  @@index([status])
}

model HostComplianceIssue {
  id              String                 @id @default(cuid())
  requestId       String
  request         HostRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  issueType       String                 // e.g. "Address Mismatch", "Document Inconsistency", "Sanctions Check", "Missing Tax ID"
  description     String                 @db.Text
  severity        ComplianceIssueSeverity @default(MEDIUM)
  status          ComplianceIssueStatus   @default(OPEN)

  createdById     String
  createdBy       User                   @relation("CreatedComplianceIssues", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime               @default(now())

  resolvedById    String?
  resolvedBy      User?                  @relation("ResolvedComplianceIssues", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolutionNotes String?                @db.Text

  updatedAt       DateTime               @updatedAt

  @@index([requestId])
  @@index([severity])
  @@index([status])
}

model HostInfoRequest {
  id                  String                 @id @default(cuid())
  requestId           String
  request             HostRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  informationRequired String                 @db.Text
  reason              String                 @db.Text
  deadline            DateTime?

  requestedById       String
  requestedBy         User                   @relation("CreatedInfoRequests", fields: [requestedById], references: [id], onDelete: Cascade)
  status              String                 @default("PENDING") // PENDING, FULFILLED

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([requestId])
  @@index([status])
}


