# ─── Copy to .env and fill in. .env is gitignored. Never put real secrets here. ───

# Database (PostgreSQL). Production now: Neon (pooled + sslmode=require).
# After the load balancer is live, move to Alibaba/AWS RDS by changing ONLY this URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homyz_dev?schema=public"

NODE_ENV="development"
PORT="3000"
HOSTNAME="0.0.0.0"

# Public site URL (emails, OAuth callbacks, Server Action origins at image build).
# Production: the load-balancer hostname, e.g. https://app.example.com — rebuild the image after changing this.
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated extra hosts for Server Actions (baked at Docker build), e.g. app.example.com
SERVER_ACTION_ALLOWED_ORIGINS=""

# Initial ADMIN seeded by `npm run db:seed` (ADMIN is never assignable via signup).
ADMIN_EMAIL="admin@homyz.local"
ADMIN_PASSWORD=""

# NextAuth (web). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Required when running more than one app instance (ALB). Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Mobile JWTs (jose-signed access + refresh). Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL="2592000"

# OTP / rate limiting
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"

# ─── OAuth (optional; each provider is enabled only when BOTH its keys are set) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ─── Email (Resend). Leave blank in dev to log emails to the console. ───
RESEND_API_KEY=""
EMAIL_FROM="Homyz <no-reply@homyz.local>"

# ─── SMS (Twilio). Leave blank in dev to log OTP codes to the console. ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ─── Redis (OPTIONAL cache). Leave REDIS_URL blank to use the database only. ───
REDIS_URL=""
REDIS_ENABLED="true"
REDIS_DEFAULT_TTL="300"
REDIS_CONNECT_TIMEOUT="2000"

# ─── AWS S3 media (production). Leave S3_BUCKET blank to store files locally (dev). ───
# Public prefix: listing-photos/, stamp-icons/
# Private prefix: host-documents/ (served only via authenticated API)
S3_BUCKET=""
S3_REGION=""
S3_PUBLIC_BASE_URL=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
