# ─── Copy to .env and fill in. .env is gitignored. Never put real secrets here. ───

# Database (PostgreSQL). Production now: Neon (pooled + sslmode=verify-full).
# After the load balancer is live, move to Alibaba/AWS RDS by changing ONLY this URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homyz_dev?schema=public"

NODE_ENV="development"
PORT="3000"
HOSTNAME="0.0.0.0"

# Public, redacted diagnostics file served at /api/diagnostics.log without login.
# In Docker production this path is backed by the homyz_diagnostics volume.
DIAGNOSTICS_LOG_FILE="/app/logs/public-diagnostics.log"

# Public site URL (emails, OAuth callbacks, Server Action origins at image build).
# Production: the load-balancer hostname, e.g. https://app.example.com — rebuild the image after changing this.
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated extra hosts for Server Actions (baked at Docker build), e.g. app.example.com
SERVER_ACTION_ALLOWED_ORIGINS=""

# Initial ADMIN seeded by `npm run db:seed` (ADMIN is never assignable via signup).
ADMIN_EMAIL="admin@homyz.local"
ADMIN_PASSWORD=""

# NextAuth (web). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
PAYOUT_ENCRYPTION_KEY=""

# StayElite commercial features remain off until policy, migration, and
# database-backed concurrency gates are approved.
STAYELITE_POINTS_REDEMPTION_ENABLED="false"
STAYELITE_COMMERCIAL_POLICY_VERSION=""

# Required when running more than one app instance (ALB). Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Mobile JWTs (jose-signed access + refresh). Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL="2592000"

# OTP / rate limiting
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"

# ─── OAuth (optional; each provider is enabled only when BOTH its keys are set) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ─── Email (Resend). Leave blank in dev to log emails to the console. ───
RESEND_API_KEY=""
EMAIL_FROM="Homyz <no-reply@homyz.local>"

# ─── SMS (Twilio). Leave blank in dev to log OTP codes to the console. ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ─── Redis (OPTIONAL cache). Leave REDIS_URL blank to use the database only. ───
REDIS_URL=""
REDIS_ENABLED="true"
REDIS_DEFAULT_TTL="300"
REDIS_CONNECT_TIMEOUT="2000"

# ─── Host check-in instruction engagement telemetry (optional) ───
# Set this to the UTC instant at which instruction-view events begin to be
# collected in a deployed environment. Leave blank until tracking is activated:
# historical reservations before this timestamp are shown as untracked, never
# as "not viewed".
CHECKIN_INSTRUCTIONS_TRACKING_STARTED_AT=""

# ─── Internal scheduled evaluation (required to award Guest Favorite automatically). ───
# Generate with: openssl rand -base64 32. The host systemd timer sends this only to
# the loopback-only internal API endpoint; never expose it as a NEXT_PUBLIC variable.
GUEST_FAVORITE_EVALUATION_CRON_SECRET=""
SUPERHOST_EVALUATION_CRON_SECRET=""
HOMYZ_APP_INTERNAL_URL="http://127.0.0.1:3000"

# ─── Moderation background jobs (required in production). ───
# Generate with: openssl rand -base64 32. The scheduler must send it as either
# Authorization: Bearer <secret> or x-cron-key; never expose it to the browser.
CRON_SECRET=""

# ─── Saudi property-license verification ───
# The only bundled provider is an explicitly simulated development fixture.
# Keep production on `government` until the Ministry's accommodation contract
# and host-authorisation mapping are configured; it fails closed to manual review.
SAUDI_LICENSE_VERIFICATION_ENABLED="false"
SAUDI_LICENSE_PROVIDER="government"
SAUDI_LICENSE_AUTO_APPROVAL_ENABLED="false"
# Required to treat a successful travel-agency record as authorization. Keep false
# unless this endpoint is approved for your accommodation-host workflow.
SAUDI_LICENSE_TRAVEL_AGENCY_AUTO_APPROVAL_ENABLED="false"
# Local-only redacted request/response diagnostics. Never logs tokens or full licences.
SAUDI_LICENSE_DEBUG_LOGS="false"
SAUDI_LICENSE_INTEGRATION_KEY=""
SAUDI_LICENSE_INTEGRATION_SECRET=""

# ─── Media service (owns the root upload/ folder). Next.js calls this for upload/delete. ───
# Internal API (Docker Compose overrides this to http://media:4001):
MEDIA_SERVER_URL=""
# Generate with: openssl rand -base64 32  (required when MEDIA_SERVER_URL is set, and in Docker)
MEDIA_SERVER_SECRET=""
# Browser-facing origin for images. Use this — not https://homyz.co/:4001
# Now (open port):     http://homyz.co:4001
# Later (subdomain):   https://media.homyz.co
MEDIA_PUBLIC_BASE_URL=""
# Maximum upload size for the dedicated media service (bytes). Defaults to 200MB.
MEDIA_MAX_BYTES="209715200"

# ─── AWS S3 media (optional). When S3_BUCKET is set, Next.js talks to S3 directly and skips the media service. ───
# Later: keep the media service and switch *its* backend to S3 instead.
# Public prefix: listing-photos/, stamp-icons/, guidebook-photos/
# Private prefix: host-documents/ (served only via authenticated API)
S3_BUCKET=""
S3_REGION=""
S3_PUBLIC_BASE_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ─── Map Basemap (CARTO Voyager tiles) ───
# Get your API key at https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=""
